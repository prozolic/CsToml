<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>

    <!--
      TUnit finds tests with its source generator (its default mode; do not enable reflection mode),
      so the same project also runs as a NativeAOT executable:
      dotnet publish -c Release -f net10.0 -r <rid>
      PublishAot is set only for such a publish. Set unconditionally, it would also put its feature switches
      (no dynamic code, size-optimized LINQ, source-generated Bind(), ...) into the JIT build that `dotnet test` runs.
    -->
    <PublishAot Condition="'$(RuntimeIdentifier)' != '' or '$(_IsPublishing)' == 'true'">true</PublishAot>
    <!-- Report AOT and trimming problems in test code on every build, not only when publishing. -->
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <!-- `union` declaration tests compile only on net11.0; everything else runs on every TFM. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net11.0'">
    <Compile Remove="Declarations/Net11/**/*.cs" />
    <Compile Remove="Generator/Net11/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="TUnit.Assertions" Version="1.81.10" />
    <PackageReference Include="TUnit.Engine" Version="1.81.10" />
    <PackageReference Include="Utf8StringInterpolation" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CsToml\CsToml.csproj" />
    <ProjectReference Include="..\..\src\CsToml.Generator\CsToml.Generator.csproj">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

</Project>
